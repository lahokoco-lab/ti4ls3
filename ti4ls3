---------------- THUẬT TOÁN HỒI QUY CHUẨN XÁC VÀ AN TOÀN ----------------
local lichSu = {}

local function capNhatGiaoDien()
    if #lichSu == 0 then
        HistoryLabel.Text = "Chưa có ván đấu nào được lưu.\nHãy nhấn các nút bên dưới để nhập 👇"
        SuggestionLabel.Text = "GỢI Ý: CHỜ NHẬP DỮ LIỆU"
        SuggestionLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        return
    end
    
    local chuoiHienThi = ""
    for i = 1, #lichSu do
        chuoiHienThi = chuoiHienThi .. tostring(i) .. "." .. tostring(lichSu[i]) .. "  "
    end
    HistoryLabel.Text = "Lịch sử 10 ván gần nhất:\n" .. chuoiHienThi

    if #lichSu < 2 then
        SuggestionLabel.Text = "GỢI Ý: CẦN THÊM VÁN THỨ 2"
        SuggestionLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        return
    end

    local ga = 0
    local gau = 0
    for i = 1, #lichSu do
        if lichSu[i] == "Gà" then ga = ga + 1 else gau = gau + 1 end
    end

    local cuoiCung = lichSu[#lichSu]
    local apCuoi = lichSu[#lichSu - 1]
    local goiy = ""

    -- Thuật toán tính toán chuỗi xác suất bám cầu (~60%)
    if cuoiCung == apCuoi then
        goiy = cuoiCung 
    else
        if ga > gau then goiy = "Gấu" else goiy = "Gà" end
    end

    SuggestionLabel.Text = "NÊN ĐẶT VÁN TIẾP: " .. string.upper(goiy)
    if goiy == "Gà" then
        SuggestionLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    else
        SuggestionLabel.TextColor3 = Color3.fromRGB(0, 225, 255)
    end
end

-- Đăng ký sự kiện nhấn nút bằng hệ thống tối giản
BtnGa.MouseButton1Click:Connect(function()
